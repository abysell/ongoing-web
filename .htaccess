# OnGoing ERP Landing - Apache Configuration for cPanel
DirectoryIndex index.php index.html
RewriteEngine On

# Redirect index.html to index.php
RewriteRule ^index\.html$ index.php [R=301,L]

# Force UTF-8 Encoding to fix character parsing issues
AddDefaultCharset UTF-8

# Ensure api/chat request routes directly to the PHP API handler
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/chat$ api/chat/index.php [L]

# 301 Redirects for Legacy Modules to New Landing Pages
Redirect 301 /modulos/crm-ventas.html /lp/crm.html
Redirect 301 /modulos/gestion-operativa.html /lp/servicios.html

# Prevent directory listing for privacy and security
Options -Indexes

# Security Headers Configuration
<IfModule mod_headers.c>
    # 1. HSTS (Strict-Transport-Security)
    # Forces browsers to use HTTPS for 2 years (63072000s) including subdomains and preload support
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # 2. X-Frame-Options
    # Prevents clickjacking by allowing iframe embedding only from the same origin
    Header always set X-Frame-Options "SAMEORIGIN"

    # 3. X-Content-Type-Options
    # Disables MIME-type sniffing to prevent executing non-executable files as JS/CSS
    Header always set X-Content-Type-Options "nosniff"

    # 4. Referrer-Policy
    # Protects user privacy by sending the full URL only on same-origin requests
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 5. Permissions-Policy
    # Disables unused hardware/browser features to protect privacy (camera, location, mic, etc.)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), midi=(), magnetometer=(), gyroscope=()"

    # 6. Content-Security-Policy (CSP)
    # Restricts loading of external resources. Optimized to allow Google Tag Manager/Analytics, Tailwind CSS CDN, Lucide Icons, Google Ads/DoubleClick, Cloudflare Insights, and Kodex API
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.tailwindcss.com https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: https://www.google.com https://*.doubleclick.net https://www.googleadservices.com; connect-src 'self' https://kodex.ongoing2.mx https://www.google-analytics.com https://www.googletagmanager.com https://*.google-analytics.com https://unpkg.com https://cloudflareinsights.com https://*.cloudflareinsights.com https://www.google.com https://*.doubleclick.net https://www.google.com.mx https://www.googleadservices.com; frame-ancestors 'self';"
</IfModule>
